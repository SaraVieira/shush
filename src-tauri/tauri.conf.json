{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "identifier": "com.iamsaravieira.sush",
  "productName": "Shush",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "pnpm dev -- --host 127.0.0.1 --port 53214",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:53214",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Shush",
        "width": 360,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "center": true,
        "backgroundColor": "#00000000"
      }
    ]
  }
}
